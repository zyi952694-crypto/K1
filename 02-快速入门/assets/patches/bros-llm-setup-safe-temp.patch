+test -s Qwen2.5-0.5B-Instruct-Q4_0.gguf
+test -s qwen2.5:0.5b.modelfile
+if [ "$(head -c 4 Qwen2.5-0.5B-Instruct-Q4_0.gguf)" != "GGUF" ]; then
+    echo "Downloaded model is not a GGUF file" >&2
+    exit 1
+fi
 ollama create qwen2.5:0.5b -f qwen2.5:0.5b.modelfile
 
-# Delete the model directory
-cd ~
-rm -rf $MODEL_DIR
-
 echo "All dependencies installed successfully."
