+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Read-only command fixtures for test_signal.py; never invoke network tools."""
+import os
+from pathlib import Path
+import sys
+
+args = sys.argv[1:]
+name = Path(sys.argv[0]).name
+if name == 'iw':
+    if os.environ.get('WIFI_TEST_IW_FAILURE'):
+        sys.exit(1)
+    if args == ['dev', 'wlan0', 'link']:
+        mac = os.environ.get('WIFI_TEST_LINK_MAC', 'aa:bb:cc:dd:ee:01')
+        signal = os.environ.get('WIFI_TEST_SIGNAL', '-66 dBm')
+        print(f'Connected to {mac} (on wlan0)\n\tSSID: TestAP\n\tsignal: {signal}')
+    elif args == ['dev', 'wlan0', 'scan', 'dump']:
+        print('BSS aa:bb:cc:dd:ee:02(on wlan0)\n\tsignal: -84.00 dBm\n'
+              'BSS aa:bb:cc:dd:ee:01(on wlan0) -- associated\n\tsignal: -61.00 dBm')
+    else:
+        sys.exit(90)
+elif name == 'nmcli':
+    field = args[args.index('-f') + 1]
+    values = {
+        'RUNNING': 'running',
+        'DEVICE,TYPE,STATE': 'wlan0:wifi:connected',
+        'NAME,TYPE,DEVICE': 'TestAP:802-11-wireless:wlan0',
+        'GENERAL.HWADDR': r'GENERAL.HWADDR:11\:22\:33\:44\:55\:66',
+        'IP4.ADDRESS,IP4.GATEWAY': 'IP4.ADDRESS[1]:192.0.2.4/24\nIP4.GATEWAY:192.0.2.1',
+        'ACTIVE,BSSID,SSID,FREQ,SIGNAL,SECURITY':
+            r'yes:aa\:bb\:cc\:dd\:ee\:01:TestAP:2412:65:WPA2',
+        'BSSID,SSID,FREQ,SIGNAL,SECURITY':
+            r'aa\:bb\:cc\:dd\:ee\:01:TestAP:2412:65:WPA2' + '\n' +
+            r'aa\:bb\:cc\:dd\:ee\:02:TestAP:5180:80:WPA2',
+    }
+    if field not in values:
+        sys.exit(90)
+    print(values[field])
+else:
+    sys.exit(90)
diff --git a/tests/test_signal.py b/tests/test_signal.py
new file mode 100644
--- /dev/null
+++ b/tests/test_signal.py
@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Run: python3 tests/test_signal.py /absolute/path/to/build/libwifi.so.
+
+Exercise the public C API with deterministic NetworkManager and iw fixtures.
+No network changes or scans are performed.
+"""
+import ctypes as c
+import os
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+
+class StationInfo(c.Structure):
+    _fields_ = [('id', c.c_int), ('freq', c.c_int), ('rssi', c.c_int),
+                ('bssid', c.c_uint8 * 6), ('ssid', c.c_char * 33),
+                ('mac_addr', c.c_uint8 * 6), ('ip_addr', c.c_uint8 * 4),
+                ('gw_addr', c.c_uint8 * 4), ('sec', c.c_int)]
+
+
+class ScanResult(c.Structure):
+    _fields_ = [('bssid', c.c_uint8 * 6), ('ssid', c.c_char * 33),
+                ('freq', c.c_uint32), ('rssi', c.c_int),
+                ('key_mgmt', c.c_int), ('scan_action', c.c_bool)]
+
+
+LIBRARY = c.CDLL(str(Path(sys.argv.pop(1)).resolve()))
+LIBRARY.wifi_sta_get_info.argtypes = [c.POINTER(StationInfo)]
+LIBRARY.wifi_get_scan_results.argtypes = [c.POINTER(ScanResult), c.c_char_p,
+                                         c.POINTER(c.c_uint32), c.c_uint32]
+
+
+class SignalTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.bin = Path(self.tmp.name)
+        fixture = Path(__file__).with_name('mock_wifi_command.py')
+        for name in ['nmcli', 'iw']:
+            shutil.copyfile(fixture, self.bin / name)
+            (self.bin / name).chmod(0o755)
+        self.env = patch.dict(os.environ, {'PATH': str(self.bin) + ':' + os.environ['PATH']})
+        self.env.start()
+        self.assertEqual(LIBRARY.wifi_init(), 0)
+
+    def tearDown(self):
+        LIBRARY.wifi_deinit()
+        self.env.stop()
+        self.tmp.cleanup()
+
+    def station(self):
+        info = StationInfo()
+        self.assertEqual(LIBRARY.wifi_sta_get_info(c.byref(info)), 0)
+        self.assertEqual(info.ssid, b'TestAP')
+        self.assertEqual(info.freq, 2412)
+        self.assertEqual(list(info.ip_addr), [192, 0, 2, 4])
+        self.assertEqual(info.sec, 4)
+        return info
+
+    def scan(self, size=2, ssid=None):
+        entries = (ScanResult * size)()
+        count = c.c_uint32()
+        self.assertEqual(LIBRARY.wifi_get_scan_results(entries, ssid, c.byref(count), size), 0)
+        return count.value, entries
+
+    def test_link_uses_dbm_not_nm_percent(self):
+        self.assertEqual(self.station().rssi, -66)
+
+    def test_cached_scan_matches_bssid_not_order_or_ssid(self):
+        count, entries = self.scan()
+        self.assertEqual(count, 2)
+        self.assertEqual([x.rssi for x in entries], [-61, -84])
+        self.assertEqual([x.freq for x in entries], [2412, 5180])
+        self.assertEqual([x.key_mgmt for x in entries], [4, 4])
+
+    def test_mismatched_link_has_no_signal(self):
+        with patch.dict(os.environ, {'WIFI_TEST_LINK_MAC': 'aa:bb:cc:dd:ee:02'}):
+            self.assertEqual(self.station().rssi, 0)
+
+    def test_unavailable_iw_preserves_connection_and_scan(self):
+        with patch.dict(os.environ, {'WIFI_TEST_IW_FAILURE': '1'}):
+            self.assertEqual(self.station().rssi, 0)
+            count, entries = self.scan()
+            self.assertEqual(count, 2)
+            self.assertEqual([x.rssi for x in entries], [0, 0])
+
+    def test_invalid_or_unitless_levels_are_unavailable(self):
+        for signal in ['65/100', '65 dBm', '-66 dB', '-200 dBm', 'nan dBm', '0 dBm', '']:
+            with self.subTest(signal=signal), patch.dict(os.environ, {'WIFI_TEST_SIGNAL': signal}):
+                self.assertEqual(self.station().rssi, 0)
+
+    def test_fractional_dbm_rounds_to_integer(self):
+        with patch.dict(os.environ, {'WIFI_TEST_SIGNAL': '-64.60 dBm'}):
+            self.assertEqual(self.station().rssi, -65)
+
+    def test_scan_capacity_filter_and_count_only_stay_unchanged(self):
+        count, entries = self.scan(size=1)
+        self.assertEqual(count, 2)
+        self.assertEqual(entries[0].rssi, -61)
+        self.assertEqual(self.scan(ssid=b'not-present')[0], 0)
+        count = c.c_uint32()
+        self.assertEqual(LIBRARY.wifi_get_scan_results(None, None, c.byref(count), 0), 0)
+        self.assertEqual(count.value, 2)
+        self.assertEqual(LIBRARY.wifi_sta_get_info(None), -6)
+        LIBRARY.wifi_deinit()
+        self.assertEqual(LIBRARY.wifi_sta_get_info(c.byref(StationInfo())), -2)
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
