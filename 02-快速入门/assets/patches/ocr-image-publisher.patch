+"""Check OCR result/image publication without loading models or camera devices."""
+
+import importlib.util
+from pathlib import Path
+import sys
+from types import ModuleType, SimpleNamespace
+import unittest
+from unittest.mock import Mock, patch
+
+import numpy as np
+from sensor_msgs.msg import CompressedImage
+from jobot_interfaces.msg import OCRResult
+
+
+def load_node():
+    """Load the production node while isolating model/downloader dependencies."""
+    substitutes = {}
+    for name, symbol in [('model_downloader', 'ModelDownloader'),
+                         ('utils', 'OCRProcessor'),
+                         ('tools', 'draw_ocr_results_dual')]:
+        module = ModuleType(name)
+        setattr(module, symbol, Mock())
+        substitutes[name] = module
+    path = Path(__file__).parents[1] / 'jobot_ppocr_py' / 'ocr_img_node.py'
+    spec = importlib.util.spec_from_file_location('ocr_image_under_test', path)
+    module = importlib.util.module_from_spec(spec)
+    with patch.dict(sys.modules, substitutes):
+        spec.loader.exec_module(module)
+    return module
+
+
+node_module = load_node()
+
+
+class TypedPublisher:
+    """Reject mismatched messages as rclpy's typed publisher does."""
+
+    def __init__(self, message_type):
+        self.message_type = message_type
+        self.messages = []
+
+    def publish(self, message):
+        if not isinstance(message, self.message_type):
+            raise TypeError(f'Expected {self.message_type}, got {type(message)}')
+        self.messages.append(message)
+
+
+class ImagePublicationTest(unittest.TestCase):
+    """Exercise the real infer_img method with deterministic OCR output."""
+
+    def setUp(self):
+        self.image = np.zeros((8, 8, 3), dtype=np.uint8)
+        self.result = [{'points': [[1, 1], [6, 1], [6, 6], [1, 6]],
+                        'score': 0.9, 'center_point': [3.5, 3.5], 'content': 'hello'}]
+        self.node = SimpleNamespace(
+            img_path='test.jpg', publish_result_img=True,
+            publisher_info=TypedPublisher(OCRResult),
+            publisher_img=TypedPublisher(CompressedImage),
+            ocr=Mock(return_value=self.result), get_logger=Mock(),
+            get_clock=lambda: SimpleNamespace(now=lambda: SimpleNamespace(
+                to_msg=lambda: OCRResult().header.stamp)))
+
+    def infer(self, image=None):
+        image = self.image if image is None else image
+        with patch.object(node_module.cv2, 'imread', return_value=image), \
+                patch.object(node_module, 'draw_ocr_results_dual', return_value=self.image), \
+                patch.object(node_module.cv2, 'imwrite', return_value=True) as write, \
+                patch.object(node_module.rclpy, 'ok', side_effect=[True, True, False]), \
+                patch.object(node_module.time, 'sleep'):
+            node_module.OCRImageInferNode.infer_img(self.node)
+            return write.call_args_list
+
+    def test_repeated_output_keeps_result_and_image_types(self):
+        writes = self.infer()
+        self.assertEqual(len(self.node.publisher_info.messages), 3)
+        self.assertEqual(len(self.node.publisher_img.messages), 2)
+        for result in self.node.publisher_info.messages:
+            self.assertEqual(result.boxes[0].content, 'hello')
+            self.assertEqual(list(result.boxes[0].points), [1., 1., 6., 1., 6., 6., 1., 6.])
+        for image in self.node.publisher_img.messages:
+            self.assertEqual(image.format, 'jpeg')
+            self.assertGreater(len(image.data), 0)
+        self.assertEqual(writes, [])
+
+    def test_default_file_output_still_publishes_result_and_writes_image(self):
+        self.node.publish_result_img = False
+        writes = self.infer()
+        self.assertEqual(len(self.node.publisher_info.messages), 1)
+        self.assertEqual(self.node.publisher_info.messages[0].boxes[0].content, 'hello')
+        self.assertEqual(self.node.publisher_img.messages, [])
+        self.assertEqual(writes[0].args[0], 'ocr_result.jpg')
+        np.testing.assert_array_equal(writes[0].args[1], self.image)
+
+    def test_missing_image_does_not_publish(self):
+        with patch.object(node_module.cv2, 'imread', return_value=None):
+            node_module.OCRImageInferNode.infer_img(self.node)
+        self.assertEqual(self.node.publisher_info.messages, [])
+        self.assertEqual(self.node.publisher_img.messages, [])
+        self.node.ocr.assert_not_called()
+        self.node.get_logger().error.assert_called_once()
+
+
+if __name__ == '__main__':
+    unittest.main()
