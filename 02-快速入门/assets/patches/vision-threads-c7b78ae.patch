+}
+
+static int detect_ai_core_count() {
+    if (const char* env = std::getenv("SPACEMIT_EP_MAX_THREADS")) {
+        const int v = std::atoi(env);
+        if (v > 0) {
+            return v;
+        }
+    }
+    int count = 0;
+    std::error_code ec;
+    const fs::path soc("/proc/device-tree/soc");
+    if (!fs::is_directory(soc, ec)) {
+        return 0;
+    }
+    for (const auto& tcm : fs::directory_iterator(soc, ec)) {
+        if (tcm.path().filename().string().rfind("tcm", 0) != 0 || !tcm.is_directory(ec)) {
+            continue;
+        }
+        for (const auto& node : fs::directory_iterator(tcm.path(), ec)) {
+            if (node.is_directory(ec) &&
+                node.path().filename().string().find("_tcm") != std::string::npos) {
+                ++count;
+            }
+        }
+    }
+    return count;
+}
+
+int clamp_ep_threads(int num_threads, const std::string& provider) {
+    if (provider != "SpaceMITExecutionProvider") {
+        return num_threads;
+    }
+    static const int max_threads = detect_ai_core_count();
+    if (max_threads > 0 && num_threads > max_threads) {
+        std::cerr << "[vision] num_threads " << num_threads << " exceeds available AI cores "
+                  << max_threads << ", using " << max_threads << std::endl;
+        return max_threads;
+    }
+    return num_threads;
 }
 
