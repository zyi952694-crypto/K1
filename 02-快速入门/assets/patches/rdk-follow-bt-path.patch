+"""Resolve the follow behavior tree through the real launch parameter pipeline."""
+
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from launch import LaunchContext
+from launch_ros.descriptions import ParameterFile
+from nav2_common.launch import RewrittenYaml
+import yaml
+
+
+PACKAGE_ROOT = Path(__file__).resolve().parents[1]
+
+
+class FollowBehaviorTreePathTest(unittest.TestCase):
+    def resolve(self, config, namespace=''):
+        parameter = ParameterFile(
+            RewrittenYaml(
+                source_file=str(config), root_key=namespace,
+                param_rewrites={'use_sim_time': 'false'}, convert_types=True),
+            allow_substs=True)
+        try:
+            result = yaml.safe_load(Path(parameter.evaluate(LaunchContext())).read_text())
+        finally:
+            parameter.cleanup()
+        return result[namespace] if namespace else result
+
+    def test_default_uses_current_install_prefix(self):
+        config = PACKAGE_ROOT / 'config/param_mini_diff_follow_point.yaml'
+        original_prefixes = os.environ.get('AMENT_PREFIX_PATH', '')
+        with tempfile.TemporaryDirectory() as work:
+            for dirname in ['install-one', 'relocated-install']:
+                prefix = Path(work) / dirname
+                marker = prefix / 'share/ament_index/resource_index/packages/rdk_navigation'
+                marker.parent.mkdir(parents=True)
+                marker.touch()
+                tree = prefix / 'share/rdk_navigation/config/behavior_tree/follow_point.xml'
+                tree.parent.mkdir(parents=True)
+                source_tree = PACKAGE_ROOT / 'config/behavior_trees/follow_point.xml'
+                tree.write_bytes(source_tree.read_bytes())
+                with patch.dict(os.environ, {'AMENT_PREFIX_PATH': f'{prefix}:{original_prefixes}'}):
+                    for namespace in ['', 'robot_a']:
+                        with self.subTest(prefix=dirname, namespace=namespace):
+                            params = self.resolve(config, namespace)
+                            navigator = params['bt_navigator']['ros__parameters']
+                            path = navigator['default_nav_to_pose_bt_xml']
+                            self.assertEqual(path, str(tree))
+                            self.assertTrue(Path(path).is_file())
+
+    def test_custom_params_keep_user_tree(self):
+        with tempfile.TemporaryDirectory() as work:
+            tree = Path(work) / 'custom.xml'
+            tree.write_text('<root/>')
+            config = Path(work) / 'params.yaml'
+            config.write_text(yaml.safe_dump({'bt_navigator': {'ros__parameters': {
+                'default_nav_to_pose_bt_xml': str(tree), 'use_sim_time': True}}}))
+            result = self.resolve(config)
+            self.assertEqual(
+                result['bt_navigator']['ros__parameters']['default_nav_to_pose_bt_xml'], str(tree))
+            self.assertFalse(result['bt_navigator']['ros__parameters']['use_sim_time'])
+
+
+if __name__ == '__main__':
+    unittest.main()
