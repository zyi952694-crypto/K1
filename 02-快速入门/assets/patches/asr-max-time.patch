diff --git a/test/test_max_time.py b/test/test_max_time.py
new file mode 100644
index 0000000..9ed73da
--- /dev/null
+++ b/test/test_max_time.py
@@ -0,0 +1,153 @@
+"""Exercise the production ASR callback without loading a model or audio device."""
+
+import importlib.util
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+import numpy as np
+
+
+class Clock:
+    """A deliberately stationary clock proves the limit uses audio duration."""
+
+    time = 0
+
+    def now(self):
+        return self
+
+    def seconds_nanoseconds(self):
+        return self.time, 0
+
+
+class Node:
+    overrides = {}
+
+    def __init__(self, name):
+        self.parameters = {}
+        self.clock = Clock()
+        self.published = []
+
+    def declare_parameter(self, name, value):
+        self.parameters[name] = self.overrides.get(name, value)
+
+    def get_parameter(self, name):
+        value = self.parameters[name]
+        return SimpleNamespace(get_parameter_value=lambda: SimpleNamespace(
+            string_value=value, double_value=value, integer_value=value, bool_value=value))
+
+    def get_logger(self):
+        return SimpleNamespace(info=lambda *a: None, warning=lambda *a: None)
+
+    def create_publisher(self, *args):
+        return SimpleNamespace(publish=self.published.append)
+
+    def create_subscription(self, *args):
+        pass
+
+    def get_clock(self):
+        return self.clock
+
+
+class Model:
+    def __init__(self):
+        self.segments = []
+
+    def generate(self, audio, lang):
+        self.segments.append(audio.copy())
+        return 'recognized'
+
+
+def load_node():
+    stubs = {
+        'rclpy': SimpleNamespace(), 'rclpy.node': SimpleNamespace(Node=Node),
+        'std_msgs': SimpleNamespace(), 'std_msgs.msg': SimpleNamespace(String=SimpleNamespace),
+        'jobot_interfaces': SimpleNamespace(),
+        'jobot_interfaces.msg': SimpleNamespace(AudioFrame=object, VADResult=object),
+        'spacemit_audio': SimpleNamespace(ASRModel=Model),
+    }
+    source = Path(__file__).parents[1] / 'jobot_asr_py/wake_asr_node.py'
+    spec = importlib.util.spec_from_file_location('asr_under_test', source)
+    module = importlib.util.module_from_spec(spec)
+    with patch.dict(sys.modules, stubs):
+        spec.loader.exec_module(module)
+    return module.WakeWordASRNode
+
+
+ASRNode = load_node()
+
+
+def frame(data, rate=16000, channels=1):
+    return SimpleNamespace(data=data, sample_rate=rate, channels=channels, sample_format=0)
+
+
+class MaxTimeTest(unittest.TestCase):
+    def setUp(self):
+        Node.overrides = {'max_time': 1.0}
+
+    def test_continuous_speech_splits_without_callback_time_or_duplicates(self):
+        node = ASRNode()
+        for _ in range(10):
+            node.audio_callback(frame([4000] * 4000))
+        self.assertEqual([len(x) for x in node.asr_model.segments], [16000, 16000])
+        self.assertEqual(len(np.concatenate(node.audio_buffer)), 8000)
+        self.assertEqual(len(node.published), 2)
+        self.assertEqual(len(node.pre_buffer), 0)
+
+    def test_large_frame_preserves_all_samples_and_resets_exact_boundary(self):
+        node = ASRNode()
+        data = np.arange(1, 32001, dtype=np.int16)
+        node.audio_callback(frame(data))
+        self.assertEqual([len(x) for x in node.asr_model.segments], [16000, 16000])
+        np.testing.assert_array_equal(np.concatenate(node.asr_model.segments), data)
+        self.assertFalse(node.state)
+        self.assertEqual(node.audio_buffer, [])
+        node.audio_callback(frame([5000] * 16000))
+        np.testing.assert_array_equal(node.asr_model.segments[-1], [5000] * 16000)
+
+    def test_preroll_counts_toward_limit(self):
+        node = ASRNode()
+        node.audio_callback(frame([0] * 8000))
+        node.audio_callback(frame([5000] * 8000))
+        np.testing.assert_array_equal(node.asr_model.segments[0], [0] * 8000 + [5000] * 8000)
+        self.assertFalse(node.state)
+
+    def test_short_speech_still_finishes_after_silence(self):
+        Node.overrides = {'max_time': 10.0}
+        node = ASRNode()
+        node.audio_callback(frame([5000] * 8000))
+        node.clock.time = 1
+        node.audio_callback(frame([0] * 8000))
+        self.assertEqual(node.asr_model.segments, [])
+        node.clock.time = 2
+        node.audio_callback(frame([0] * 8000))
+        self.assertEqual([len(x) for x in node.asr_model.segments], [24000])
+        self.assertEqual(list(node.pre_buffer), [0] * 8000)
+        self.assertFalse(node.state)
+        self.assertEqual(node.audio_buffer, [])
+
+    def test_external_vad_and_resampled_stereo_obey_same_limit(self):
+        Node.overrides = {'max_time': 1.0, 'use_vad': True}
+        node = ASRNode()
+        node.vad_callback(SimpleNamespace(is_speech=True))
+        node.audio_callback(frame([5000, 0] * 32000, rate=32000, channels=2))
+        self.assertEqual([len(x) for x in node.asr_model.segments], [16000])
+
+    def test_empty_frames_do_not_start_recording(self):
+        node = ASRNode()
+        node.audio_callback(frame([]))
+        self.assertFalse(node.state)
+        self.assertEqual(node.asr_model.segments, [])
+
+    def test_invalid_limits_are_rejected(self):
+        for value in [0.0, -1.0, float('nan'), float('inf')]:
+            with self.subTest(value=value):
+                Node.overrides = {'max_time': value}
+                with self.assertRaises(ValueError):
+                    ASRNode()
+
+
+if __name__ == '__main__':
+    unittest.main()
