diff --git a/python/tests/test_demo_errors.py b/python/tests/test_demo_errors.py
new file mode 100644
index 0000000..17e96cf
--- /dev/null
+++ b/python/tests/test_demo_errors.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""Run the real demo with injected synthesis and output failures."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+FAKE = '''
+import os
+from pathlib import Path
+counter = 0
+class Config:
+    @staticmethod
+    def preset(name): return Config()
+    def with_provider(self, name): return self
+class Result:
+    def __init__(self, index):
+        self.is_success = index != int(os.environ.get("FAIL_SYNTH", "0"))
+        self.index = index
+        self.message = "injected failure"
+        self.duration_ms = 100
+        self.rtf = 0.1
+        self.audio_float = [0.1] * 10
+    def __bool__(self): return self.is_success
+    def save(self, name):
+        if not self.is_success or self.index == int(os.environ.get("FAIL_SAVE", "0")):
+            return False
+        Path(name).write_bytes(b"fixture audio")
+        return True
+class Engine:
+    engine_name = "fixture"
+    sample_rate = 16000
+    def __init__(self, config=None): pass
+    def set_speed(self, speed): pass
+    def synthesize(self, text):
+        global counter
+        counter += 1
+        return Result(counter)
+def synthesize_to_file(text, filename):
+    return Engine().synthesize(text).save(filename)
+'''
+
+
+def main():
+    source = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else (
+        Path(__file__).resolve().parents[1] / "examples/tts_file_demo.py")
+    cases = [("success", 0, 0)]
+    cases += [(f"synthesis-{i}", i, 0) for i in range(1, 8)]
+    cases += [(f"save-{i}", 0, i) for i in range(1, 8)]
+    outcomes = []
+    for name, synth, save in cases:
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            (root / "spacemit_tts.py").write_text(FAKE)
+            env = dict(os.environ, PYTHONPATH=directory, FAIL_SYNTH=str(synth),
+                       FAIL_SAVE=str(save), PYTHONDONTWRITEBYTECODE="1")
+            result = subprocess.run([sys.executable, str(source)], cwd=root, env=env,
+                                    capture_output=True, text=True, timeout=20)
+            if synth or save:
+                passed = result.returncode != 0 and "completed successfully" not in result.stdout
+            else:
+                passed = result.returncode == 0 and len(list(root.glob("*.wav"))) == 7
+                passed = passed and "completed successfully" in result.stdout
+            outcomes.append(dict(case=name, passed=passed, returncode=result.returncode))
+    print(json.dumps(outcomes, indent=2))
+    return 0 if all(case["passed"] for case in outcomes) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
